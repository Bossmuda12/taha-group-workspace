# Database — di Railway diisi otomatis lewat referensi ${{Postgres.DATABASE_URL}}
# Untuk lokal (opsional pakai Postgres lokal juga), isi manual:
DATABASE_URL="postgresql://user:password@localhost:5432/taha_group"

# JWT session secret - ganti dengan string acak yang panjang
JWT_SECRET="ganti-dengan-string-rahasia-yang-sangat-panjang"

# ==== Email (via Resend - https://resend.com, gratis untuk kebutuhan kecil) ====
# 1. Daftar di https://resend.com/signup
# 2. Buat API Key di https://resend.com/api-keys, copy nilainya (diawali re_)
# 3. Isi di bawah ini
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
# Opsional: setelah domain sendiri diverifikasi di Resend, ganti ke alamat domain sendiri.
# Selama belum ada domain terverifikasi, alamat default ini (onboarding@resend.dev)
# hanya bisa mengirim ke email pemilik akun Resend (mode sandbox).
RESEND_FROM_EMAIL="Taha Group Work Space <onboarding@resend.dev>"

# ==== WhatsApp (GRATIS, via Baileys - WhatsApp Web multi-device) ====
WA_ENABLED="true"
# Kosongkan jika mau pakai scan QR (di komputer sendiri). Isi nomor WA Admin
# (format 62xxxxxxxxxxx) jika dijalankan di server tanpa layar seperti
# Railway — sistem akan pakai kode pairing 8 digit, bukan QR.
WA_PAIRING_PHONE=""

# Nomor WA & email Admin utama, dipakai untuk fallback notifikasi sistem
ADMIN_WHATSAPP="6281234567890"
ADMIN_EMAIL="admin@gmail.com"

PORT=3000
