generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERADMIN   // Induk / pemegang utama
  DIVISION_HEAD
  STAFF
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
  OVERDUE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum NotifChannel {
  WHATSAPP
  EMAIL
  INBOX
}

enum NotifStatus {
  PENDING
  SENT
  FAILED
}

enum CoordinationStatus {
  PENDING
  APPROVED
  REJECTED
}

model Division {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  icon        String   @default("Building2")
  color       String   @default("#0A84FF")
  createdAt   DateTime @default(now())
  users       User[]
  secondaryUsers User[] @relation("SecondDivision")
  tasks       Task[]
  products    Product[]
  isCore      Boolean  @default(false)
  coordinationFrom CoordinationRequest[] @relation("CoordinationFromDivision")
  coordinationTo   CoordinationRequest[] @relation("CoordinationToDivision")
}

model User {
  id            String   @id @default(cuid())
  username      String   @unique
  fullName      String
  address       String
  whatsapp      String
  email         String   @unique
  passwordHash  String
  position      String
  role          Role     @default(STAFF)
  status        String   @default("ACTIVE") // ACTIVE, PENDING, SUSPENDED
  emailVerified Boolean  @default(true) // default true supaya akun lama tidak terkunci; akun baru diset false saat daftar
  avatarColor   String   @default("#0A84FF")
  avatarUrl     String?
  divisionId    String?
  division      Division? @relation(fields: [divisionId], references: [id])
  secondDivisionId String?
  secondDivision   Division? @relation("SecondDivision", fields: [secondDivisionId], references: [id])
  createdAt     DateTime @default(now())

  tasksAssigned   Task[]        @relation("AssignedTo")
  tasksCreated    Task[]        @relation("CreatedBy")
  dailyRecords    DailyRecord[]
  advertisingRecords AdvertisingRecord[]
  csRecords       CsRecord[]
  accountingRecords AccountingRecord[]
  payslips        Payslip[]
  notifications   Notification[]
  messagesSent    Message[]     @relation("MessageSender")
  messagesReceived Message[]    @relation("MessageRecipient")
  passwordResets  PasswordReset[]
  csPerformances       CsPerformance[] @relation("CsPerformanceOf")
  csPerformanceEntries CsPerformance[] @relation("CsPerformanceEntries")
  coordinationRequestsMade    CoordinationRequest[] @relation("CoordinationFrom")
  coordinationRequestsDecided CoordinationRequest[] @relation("CoordinationDecidedBy")
  taskAttachments TaskAttachment[]
  conversationsCreated Conversation[]       @relation("ConversationCreatedBy")
  conversationMembers  ConversationMember[]
  chatMessages         ChatMessage[]        @relation("ChatMessageSender")
  emailVerifications   EmailVerification[]
}

// Kode verifikasi 6-digit yang dikirim ke email saat registrasi,
// wajib dikonfirmasi user sebelum akunnya masuk antrean aktivasi Admin.
model EmailVerification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  code      String
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Task {
  id           String       @id @default(cuid())
  title        String
  description  String
  fileUrl      String?
  fileName     String?
  divisionId   String
  division     Division     @relation(fields: [divisionId], references: [id])
  assignedToId String?
  assignedTo   User?        @relation("AssignedTo", fields: [assignedToId], references: [id])
  createdById  String
  createdBy    User         @relation("CreatedBy", fields: [createdById], references: [id])
  status       TaskStatus   @default(TODO)
  priority     TaskPriority @default(MEDIUM)
  deadline     DateTime
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  attachments  TaskAttachment[]
}

// Lampiran tambahan pada tugas (mis. bukti pengerjaan/hasil kerja), gaya Trello:
// bisa banyak file per tugas, diunggah oleh siapa pun yang berhak melihat tugas tsb.
model TaskAttachment {
  id           String   @id @default(cuid())
  taskId       String
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  url          String
  name         String
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())
}

model DailyRecord {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  date        DateTime
  summary     String
  hoursWorked Float    @default(0)
  achievements String?
  obstacles   String?
  createdAt   DateTime @default(now())
}

model AdvertisingRecord {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  date          DateTime
  teamName      String
  closingCount  Int      @default(0)
  leadsCount    Int      @default(0)
  adAccount     String
  facebookName  String
  spendBudget   Float    @default(0)
  productId     String?
  product       Product? @relation(fields: [productId], references: [id])
  notes         String?
  createdAt     DateTime @default(now())
}

model AccountingRecord {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  date        DateTime
  type        String   // OUTFLOW, PURCHASE, RECAP
  category    String
  description String
  amount      Float
  attachment  String?
  createdAt   DateTime @default(now())
}

model Payslip {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  period     String   // e.g. "2026-07"
  baseSalary Float
  bonus      Float    @default(0)
  deduction  Float    @default(0)
  total      Float
  fileUrl    String?
  createdAt  DateTime @default(now())
}

model CsRecord {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  date          DateTime
  incomingChats Int      @default(0)
  closingCount  Int      @default(0)
  leadsCount    Int      @default(0)
  productId     String?
  product       Product? @relation(fields: [productId], references: [id])
  obstacles     String?
  notes         String?
  createdAt     DateTime @default(now())
}

model Product {
  id          String   @id @default(cuid())
  name        String
  sku         String?
  price       Float    @default(0)
  divisionId  String?
  division    Division? @relation(fields: [divisionId], references: [id])
  isCustom    Boolean  @default(false)
  createdAt   DateTime @default(now())
  advertisingRecords AdvertisingRecord[]
  csRecords   CsRecord[]
}

model CsPerformance {
  id            String   @id @default(cuid())
  csUserId      String
  csUser        User     @relation("CsPerformanceOf", fields: [csUserId], references: [id])
  date          DateTime
  resi          String?
  closingCount  Int      @default(0)
  deliveryCount Int      @default(0)
  returCount    Int      @default(0)
  successCount  Int      @default(0)
  notes         String?
  enteredById   String
  enteredBy     User     @relation("CsPerformanceEntries", fields: [enteredById], references: [id])
  createdAt     DateTime @default(now())
}

model Message {
  id           String   @id @default(cuid())
  senderId     String
  sender       User     @relation("MessageSender", fields: [senderId], references: [id])
  recipientId  String
  recipient    User     @relation("MessageRecipient", fields: [recipientId], references: [id])
  subject      String
  body         String
  read         Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model Notification {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  channel   NotifChannel
  title     String
  body      String
  link      String?
  read      Boolean      @default(false)
  status    NotifStatus  @default(PENDING)
  meta      String?
  createdAt DateTime     @default(now())
  sentAt    DateTime?
}

// Chat internal gaya WhatsApp: percakapan pribadi (2 orang) atau grup (banyak orang),
// pesan bisa membalas pesan lain (reply), ditampilkan lewat widget chat mengambang.
model Conversation {
  id          String   @id @default(cuid())
  isGroup     Boolean  @default(false)
  name        String?
  createdById String
  createdBy   User     @relation("ConversationCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  members     ConversationMember[]
  messages    ChatMessage[]
}

model ConversationMember {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime?

  @@unique([conversationId, userId])
}

model ChatMessage {
  id             String        @id @default(cuid())
  conversationId String
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User          @relation("ChatMessageSender", fields: [senderId], references: [id])
  body           String
  replyToId      String?
  replyTo        ChatMessage?  @relation("ChatReply", fields: [replyToId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies        ChatMessage[] @relation("ChatReply")
  createdAt      DateTime      @default(now())
}

// Pengajuan koordinasi antar divisi (mis. minta bantuan tim lain / kerja sama lintas divisi).
// Wajib disetujui Founder (CEO) sebelum divisi tujuan dianggap resmi terlibat.
model CoordinationRequest {
  id             String             @id @default(cuid())
  title          String
  description    String
  fromUserId     String
  fromUser       User               @relation("CoordinationFrom", fields: [fromUserId], references: [id])
  fromDivisionId String
  fromDivision   Division           @relation("CoordinationFromDivision", fields: [fromDivisionId], references: [id])
  toDivisionId   String
  toDivision     Division           @relation("CoordinationToDivision", fields: [toDivisionId], references: [id])
  status         CoordinationStatus @default(PENDING)
  decidedById    String?
  decidedBy      User?              @relation("CoordinationDecidedBy", fields: [decidedById], references: [id])
  decisionNote   String?
  decidedAt      DateTime?
  createdAt      DateTime           @default(now())
}
